#!/usr/bin/env bash

# Resolve repository directory to where this script is located
REPO_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$REPO_DIR"

echo "=== git status ==="
git status

echo ""
echo "=== git add . ==="
git add .

echo ""
echo "=== git commit -m \"update\" ==="
git commit -m "update" || echo "Nothing new to commit."

echo ""
echo "=== git branch -M main ==="
git branch -M main

echo ""
echo "=== git push -u origin main ==="
git push -u origin main

echo ""
echo "=== git status ==="
git status
