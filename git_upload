#!/bin/bash
set -e

echo "=== 1. Git Status ==="
git status

echo ""
echo "=== 2. Staging all changes (git add .) ==="
git add .

echo ""
echo "=== 3. Committing changes (git commit -m \"update\") ==="
git commit -m "update" || echo "Nothing new to commit."

echo ""
echo "=== 4. Setting branch to main (git branch -M main) ==="
git branch -M main

echo ""
echo "=== 5. Pushing to origin main (git push -u origin main) ==="
git push -u origin main

echo ""
echo "=== 6. Final Git Status ==="
git status
