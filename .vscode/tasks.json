{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Run Windows Desktop",
      "type": "shell",
      "command": "flutter run -d windows",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$dart-build"]
    },
    {
      "label": "Flutter: Build Windows Release",
      "type": "shell",
      "command": "flutter build windows",
      "group": "build",
      "problemMatcher": ["$dart-build"]
    },
    {
      "label": "Flutter: Run Linux Desktop",
      "type": "shell",
      "command": "flutter run -d linux",
      "group": "build",
      "problemMatcher": ["$dart-build"]
    },
    {
      "label": "Flutter: Build Linux Release",
      "type": "shell",
      "command": "flutter build linux",
      "group": "build",
      "problemMatcher": ["$dart-build"]
    },
    {
      "label": "Ever Dialer: Heal Environment",
      "type": "shell",
      "windows": {
        "command": ".\\heal.bat"
      },
      "linux": {
        "command": "./heal.sh"
      },
      "problemMatcher": []
    },
    {
      "label": "Flutter: Run Tests",
      "type": "shell",
      "command": "flutter test",
      "group": "test",
      "problemMatcher": ["$dart-build"]
    }
  ]
}
